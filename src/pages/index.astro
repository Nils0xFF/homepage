      <div class="max-w-5xl p-10">
        <p class="p-0 text-xl leading-none tracking-tight">Hi, my name is</p>
        <h1 class="p-0 text-6xl leading-none font-heading">Nils Geschwinde</h1>
        <p class="p-0 text-xl leading-none tracking-tight">
