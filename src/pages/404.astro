---
import { getLangFromUrl, useTranslations } from "@/i18n";
import Layout from "@/layouts/layout.astro";
import { mergeSEO } from "@/shared/seo";
import { IconArrowBigLeft } from "@tabler/icons-astro";

const seo = mergeSEO({});

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout seo={seo}>
	<section
		class="mx-auto flex h-[calc(100vh-80px)] w-full max-w-screen-md flex-col items-center justify-center px-4 py-12 sm:px-12 sm:py-24"
	>
		<h1 class="text-hero">404 - Not found</h1>
		<p class="text-lg">This is not the page you were looking for</p>
		<a
			href={`/${lang}`}
			class="not-prose bg-base-900 hover:bg-base-700 border-base-900 dark:bg-base-100 dark:hover:bg-base-200 dark:border-base-100 text-background flex items-center justify-center gap-2 rounded-full border-2 px-4 py-2 font-bold"
		>
			<IconArrowBigLeft />
			<span class="text-lg font-medium">
				{t("nav.home")}
			</span>
		</a>
	</section>
</Layout>
