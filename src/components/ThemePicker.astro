---
import { IconDeviceDesktop, IconMoon, IconSun } from "@tabler/icons-astro";
---

<div class="flex gap-2">
	<button
		:class="$store.theme.getRaw() === 'light' ? 'text-primary' : ''"
		@click="$store.theme.set('light')"
	>
		<IconSun />
	</button>
	<button
		:class="$store.theme.getRaw() === 'auto' ? 'text-primary' : ''"
		@click="$store.theme.set('auto')"
	>
		<IconDeviceDesktop />
	</button>
	<button
		:class="$store.theme.getRaw() === 'dark' ? 'text-primary' : ''"
		@click="$store.theme.set('dark')"
	>
		<IconMoon />
	</button>
</div>
