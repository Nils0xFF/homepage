---
import { getLangFromUrl, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);

const t = useTranslations(lang);
---

<footer
	class="bg-background text-foreground border-foreground border-t-3 py-12"
	role="contentinfo"
>
	<div class="mx-auto flex max-w-screen-xl justify-between">
		<div>©2026 Nils Geschwinde</div>
		<nav>
			<a href={`/${lang}/imprint`}>{t("imprint")}</a>
		</nav>
	</div>
</footer>
