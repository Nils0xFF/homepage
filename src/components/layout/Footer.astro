---
import { getLangFromUrl, useTranslations } from "@/i18n";
import { IconCoffee, IconHeart } from "@tabler/icons-astro";

const lang = getLangFromUrl(Astro.url);

const t = useTranslations(lang);
---

<footer
	class="bg-background text-foreground border-foreground border-t-3 py-12"
	role="contentinfo"
>
	<div
		class="mx-auto flex max-w-screen-xl flex-col justify-between gap-6 px-4 sm:grid sm:grid-cols-2 sm:grid-rows-1 sm:gap-8 sm:px-12"
	>
		<nav class="flex flex-col items-start gap-6">
			<a
				href={`/${Astro.currentLocale}`}
				class="text-primary font-heading text-xl font-bold">Nils Geschwinde</a
			>
			<p class="small w-full"></p>
			<ul class="flex flex-wrap gap-2">
				<li>
					<a
						href="https://www.linkedin.com/in/nilsgeschwinde/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="currentColor"
							class="hover:text-primary aspect-square w-8 transition-all hover:scale-105"
						>
							<path
								d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
							></path>
						</svg>
					</a>
				</li>
				<li>
					<a
						href="https://github.com/Nils0xFF"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="currentColor"
							class="hover:text-primary aspect-square w-8 transition-all hover:scale-105"
						>
							<path
								d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-4.466 19.59c-.405.078-.534-.171-.534-.384v-2.195c0-.747-.262-1.233-.55-1.481 1.782-.198 3.654-.875 3.654-3.947 0-.874-.312-1.588-.823-2.147.082-.202.356-1.016-.079-2.117 0 0-.671-.215-2.198.82-.64-.18-1.324-.267-2.004-.271-.68.003-1.364.091-2.003.269-1.528-1.035-2.2-.82-2.2-.82-.434 1.102-.16 1.915-.077 2.118-.512.56-.824 1.273-.824 2.147 0 3.064 1.867 3.751 3.645 3.954-.229.2-.436.552-.508 1.07-.457.204-1.614.557-2.328-.666 0 0-.423-.768-1.227-.825 0 0-.78-.01-.055.487 0 0 .525.246.889 1.17 0 0 .463 1.428 2.688.944v1.489c0 .211-.129.459-.528.385-3.18-1.057-5.472-4.056-5.472-7.59 0-4.419 3.582-8 8-8s8 3.581 8 8c0 3.533-2.289 6.531-5.466 7.59z"
							></path>
						</svg>
					</a>
				</li>
			</ul>
			<span class="small">©2026 Nils Geschwinde</span>
		</nav>
		<div class="flex flex-col gap-6 sm:items-end">
			<nav class="flex grow flex-col gap-4">
				<ul class="flex grow flex-col gap-4">
					<li>
						<a
							class="hover:text-primary inline-flex cursor-pointer text-lg font-medium shadow-none transition hover:underline focus-visible:underline"
							href={`/${lang}/imprint`}>{t("imprint")}</a
						>
					</li>
				</ul>
			</nav>
			<nav class="mt-auto">
				<ul class="flex grow flex-col gap-4">
					<li>
						<span class="small inline-flex">
							Made with<IconCoffee class="text-primary mx-1 inline-block" /> and <IconHeart
								class="text-primary mx-1 inline-block"
							/>by Nils Geschwinde</span
						>
					</li>
				</ul>
			</nav>
		</div>
	</div>
</footer>
