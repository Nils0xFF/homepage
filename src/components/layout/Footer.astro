---
import { getLangFromUrl, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);

const t = useTranslations(lang);
---

<footer
	class="bg-background text-foreground border-foreground z-50 flex items-center border-t-5 py-12"
	role="contentinfo"
>
	<nav class="mx-auto">
		<a href={`/${lang}/imprint`}>{t("imprint")}</a>
	</nav>
</footer>
