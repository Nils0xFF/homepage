---
import { IconDeviceDesktop, IconMoon, IconMoonFilled, IconSun, IconSunFilled, IconDeviceDesktopFilled } from "@tabler/icons-astro";

const themes = [
  { id: "light", label: "light theme", Outline: IconSun, Filled: IconSunFilled },
  { id: "dark",  label: "dark theme",  Outline: IconMoon, Filled: IconMoonFilled },
  { id: "auto",  label: "system theme", Outline: IconDeviceDesktop, Filled: IconDeviceDesktopFilled },
];
---

<div class="flex gap-2" role="group" aria-label="Theme">
  {themes.map(({ id, label, Outline, Filled }) => (
	<button
		type="button"
		class="cursor-pointer transition-colors"
		:class={`$store.theme.getRaw() === '${id}' ? 'text-primary-text' : 'text-foreground-muted hover:text-foreground'`}
      	:aria-pressed={`$store.theme.getRaw() === '${id}'`}
      	@click={`$store.theme.set('${id}')`}
		aria-label={label}
	>
      <Outline x-cloak x-show={`$store.theme.getRaw() !== '${id}'`} />
      <Filled x-cloak x-show={`$store.theme.getRaw() === '${id}'`} />
	</button>
  ))}
</div>
