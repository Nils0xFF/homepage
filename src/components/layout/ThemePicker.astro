---
import { IconDeviceDesktop, IconMoon, IconSun } from "@tabler/icons-astro";
---

<div class="flex gap-2">
	<button
		class="hover:text-primary-hover cursor-pointer transition"
		:class="$store.theme.getRaw() === 'light' ? 'text-primary-active' : ''"
		@click="$store.theme.set('light')"
	>
		<IconSun stroke="3" />
	</button>
	<button
		class="hover:text-primary-hover cursor-pointer transition"
		:class="$store.theme.getRaw() === 'dark' ? 'text-primary-active' : ''"
		@click="$store.theme.set('dark')"
	>
		<IconMoon stroke="3" />
	</button>
	<button
		class="hover:text-primary-hover cursor-pointer transition"
		:class="$store.theme.getRaw() === 'auto' ? 'text-primary-active' : ''"
		@click="$store.theme.set('auto')"
	>
		<IconDeviceDesktop stroke="3" />
	</button>
</div>
