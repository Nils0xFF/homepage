---
import { getBasePathFromPath, getLangFromUrl } from "@/i18n";
const lang = getLangFromUrl(Astro.url);

const currentPath = getBasePathFromPath(Astro.url.pathname, lang);
---

<div class="flex gap-2">
	<a
		class={`not-prose cursor-pointer hover:text-primary-hover font-bold ${lang === "en" ? "text-primary-active" : ""}`}
		href={`/en${currentPath ? currentPath : ""}`}
	>
		EN
	</a>
	<a
		class={`not-prose cursor-pointer hover:text-primary-hover font-bold ${lang === "de" ? "text-primary-active" : ""}`}
		href={`/de${currentPath ? currentPath : ""}`}
	>
		DE
	</a>
</div>
